# Copy to .env.local for local dev. Set the real values in Vercel for production.

# NextAuth secret - generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# Comma-separated channel IDs forced into the whitelist (e.g. UCxxxx,UCyyyy)
WHITELIST_CHANNELS=

# Google OAuth (from GCP -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# YouTube Data API v3 key
YOUTUBE_API_KEY=

# Google Cloud project for exact YouTube quota monitoring
YOUTUBE_QUOTA_PROJECT_ID=

# Email allowed to see the YouTube quota card on the settings page
YOUTUBE_QUOTA_VIEWER_EMAIL=

# DeepSeek API key for vocab meanings on /vocab. Get one from https://platform.deepseek.com.
DEEPSEEK_API_KEY=

# Optional overrides (defaults shown). Only set if you need to point at a different model or endpoint.
# DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
# DEEPSEEK_MODEL=deepseek-chat

# Server-only LinkNest Supabase import for /videos. Do not prefix with NEXT_PUBLIC_.
LINKNEST_SUPABASE_URL=
LINKNEST_SUPABASE_KEY=
LINKNEST_SUPABASE_TABLE=saved_links

# Tubeo primary sync store. Server-only: never expose the secret/service key to browser code.
# Run docs/supabase-sync-schema.sql in this Supabase project first.
TUBEO_SUPABASE_URL=
TUBEO_SUPABASE_SERVICE_ROLE_KEY=
TUBEO_SUPABASE_SYNC_TABLE=tubeo_user_sync_state
